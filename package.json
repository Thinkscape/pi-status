{
  "name": "@thinkscape/pi-status",
  "version": "0.2.0",
  "description": "Pi extension: configurable terminal tab title spinner with Ghostty native progress bar support.",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "author": "Thinkscape",
  "homepage": "https://github.com/Thinkscape/pi-status#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thinkscape/pi-status.git"
  },
  "bugs": {
    "url": "https://github.com/Thinkscape/pi-status/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "terminal",
    "status",
    "spinner",
    "ghostty"
  ],
  "license": "MIT",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "version:patch": "bun run scripts/version.ts patch",
    "version:minor": "bun run scripts/version.ts minor",
    "version:major": "bun run scripts/version.ts major",
    "release:patch": "bun run scripts/release.ts patch",
    "release:minor": "bun run scripts/release.ts minor",
    "release:major": "bun run scripts/release.ts major",
    "pack:dry-run": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@earendil-works/pi-tui": "0.74.0",
    "@types/bun": "^1.3.13",
    "@types/node": "25.6.0",
    "typescript": "6.0.3"
  }
}
